<?xml version="1.0" encoding="utf-8"?>
<!--
  Ubunye: ThabangVision collaboration (kopanod, the Kopano service) in the MSI of each Ubunye app
  (Light, Photo, Film). Linked by packaging/windows/package.ps1 when collab-package.ps1 sets
  UBUNYE_EXTRA_WXS, which also defines CollabBinDir (the folder holding kopanod.exe). The app's
  .wxs adds the component group to its one feature.

  One kopanod per computer, whatever apps are installed and in any order:
  - kopanod.exe goes to Program Files\ThabangVision\Collaboration, with a machine-wide
    start-at-sign-in value (HKLM Run, "ThabangVision collaboration") that starts it for each
    person who signs in, with their own data folder (%LOCALAPPDATA%\Kopano).
  - THIS FILE IS THE SAME IN ALL THREE APPS: the same component GUIDs, the same folder, the same
    value. Windows Installer then counts the apps that installed the component: removing one app
    leaves kopanod and its start at sign-in in place for the others, and removing the last app
    removes both. Never change a GUID or the folder in one app only.
  - kopanod.exe carries kopanod's own version (collab-package.ps1), so Windows Installer's file
    versioning replaces it only with a newer one: installing an app with an older kopanod never
    downgrades it.

  Stopping it (deferred, as the system, quietly; a leftover process never blocks the install):
  - UbunyeCollabStop: the last app is being removed (the component goes): every kopanod running
    from the shared folder is stopped so its file can go.
  - UbunyeCollabStopOlder: an install that brings a newer kopanod.exe than the one there: the old
    one is stopped so it can be replaced. It starts again with the next app opened or sign-in.
  The PowerShell commands build the folder from %ProgramFiles% themselves (no installer path
  inside quotes, so any folder name works). Left on purpose: each person's %LOCALAPPDATA%\Kopano
  (device key name, shared libraries), like the apps' own libraries.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?if $(sys.BUILDARCH) = x64 ?>
  <?define UbunyeKopanodGuid = "03A23517-4169-429D-B04D-0458D3ECAD79" ?>
  <?elseif $(sys.BUILDARCH) = arm64 ?>
  <?define UbunyeKopanodGuid = "B20AA931-F31C-49D4-8333-E6D0553B2020" ?>
  <?else?>
  <?define UbunyeKopanodGuid = "47A32758-AF9C-49DE-B810-4E517256DBC5" ?>
  <?endif?>
  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="UbunyeThabangVisionDir" Name="ThabangVision">
        <Directory Id="UbunyeCollabDir" Name="Collaboration" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="UbunyeCollabFiles" Directory="UbunyeCollabDir">
      <Component Id="UbunyeKopanod" Guid="$(var.UbunyeKopanodGuid)">
        <File Id="KopanodExe" Name="kopanod.exe" Source="$(var.CollabBinDir)\kopanod.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="ThabangVision collaboration" Type="string" Value="&quot;[#KopanodExe]&quot; run --standby" />
      </Component>
    </ComponentGroup>

    <!-- WixQuietExec runs the command with no window; deferred actions read it from the
         property of the same name. Return="ignore": a leftover service never blocks the install. -->
    <SetProperty Id="UbunyeCollabStop" Sequence="execute" Before="UbunyeCollabStop"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$f = Join-Path $env:ProgramFiles 'ThabangVision\Collaboration\kopanod.exe'; Get-Process -Name kopanod -ErrorAction SilentlyContinue | Where-Object Path -eq $f | Stop-Process -Force; Start-Sleep -Milliseconds 500&quot;" />
    <CustomAction Id="UbunyeCollabStop" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
        Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="UbunyeCollabStopOlder" Sequence="execute" Before="UbunyeCollabStopOlder"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$f = Join-Path $env:ProgramFiles 'ThabangVision\Collaboration\kopanod.exe'; $old = (Get-Item $f -ErrorAction SilentlyContinue).VersionInfo.FileVersion; if ($old -and (New-Object Version $old) -lt (New-Object Version '!(bind.FileVersion.KopanodExe)')) { Get-Process -Name kopanod -ErrorAction SilentlyContinue | Where-Object Path -eq $f | Stop-Process -Force; Start-Sleep -Milliseconds 500 }&quot;" />
    <CustomAction Id="UbunyeCollabStopOlder" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
        Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- $Component: what this install does to it (2 = removed, 3 = installed on this computer) -->
      <Custom Action="UbunyeCollabStop" Before="RemoveFiles" Condition="$UbunyeKopanod = 2" />
      <Custom Action="UbunyeCollabStopOlder" Before="RemoveFiles" Condition="$UbunyeKopanod = 3" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
